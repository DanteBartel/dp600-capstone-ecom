# Copy to `.env.local` for local development (never commit `.env.local`):
#   cp .env.example .env.local
#
# Next.js load order: https://nextjs.org/docs/app/guides/environment-variables
# Use NEXT_PUBLIC_* only for values safe to expose in the browser (inlined at build time).

# --- Public (browser / build) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# Database connection string (PostgreSQL, Neon, Supabase, etc.)
DATABASE_URL=

# Session signing — generate: openssl rand -base64 32
AUTH_SECRET=
